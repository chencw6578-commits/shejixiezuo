{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm install && npm install --prefix web && npm install --prefix server",
  "buildCommand": "npm --prefix web run build && npm --prefix server run build",
  "outputDirectory": "web/dist",
  "env": {
    "NODEJS_HELPERS": "0"
  },
  "regions": ["hnd1"],
  "functions": {
    "api/catch.mjs": {
      "maxDuration": 300,
      "includeFiles": "../server/node_modules/@img/**"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/catch?__vp=$1"
    },
    {
      "source": "/mcp",
      "destination": "/api/catch?__vp=mcp"
    },
    {
      "source": "/.well-known/oauth-protected-resource/mcp",
      "destination": "/api/catch?__vp=oauth/prm"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/catch?__vp=oauth/prm"
    },
    {
      "source": "/.well-known/oauth-authorization-server",
      "destination": "/api/catch?__vp=oauth/asm"
    },
    {
      "source": "/authorize",
      "destination": "/api/catch?__vp=oauth/authorize"
    },
    {
      "source": "/token",
      "destination": "/api/catch?__vp=oauth/token"
    },
    {
      "source": "/register",
      "destination": "/api/catch?__vp=oauth/register"
    },
    {
      "source": "/revoke",
      "destination": "/api/catch?__vp=oauth/revoke"
    },
    {
      "source": "/:path((?!api/|mcp|storage/|assets/|figma-plugin.zip).*)",
      "destination": "/index.html"
    }
  ]
}
