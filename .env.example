# ===== 服务 =====
PORT=4000

# ===== 认证（生产 / Vercel 必填）=====
# 会话 cookie 签名与公开分享链接 HMAC 共用同一个密钥。
# 生产环境缺失会在启动时直接报错，不会回退到默认密钥。
# 生成方式：openssl rand -hex 32
AUTH_SECRET=

# ===== Figma =====
# 在 Figma → Settings → Security → Personal access tokens 生成
# 需要文件所在团队/项目授予该 token 访问权限
FIGMA_TOKEN=

# ===== 数据库 =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/designhub

# ===== 对象存储 =====
# local = 本地磁盘（开发默认，落到 STORAGE_LOCAL_DIR，由服务端 /storage 静态托管）
# s3    = S3/MinIO（常驻生产）
# blob  = Vercel Blob（Serverless 默认，BLOB_READ_WRITE_TOKEN 由 Vercel 连接 Store 后自动注入）
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# S3/MinIO 配置（STORAGE_DRIVER=s3 时生效）
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=designhub
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# 有公网/内网可直达 MinIO 的基址时填写，如 http://minio.internal:9000；留空用预签名 URL
S3_PUBLIC_BASE_URL=
# R2 的 r2.dev / 自定义域已直接指向桶，需设为 false，否则 URL 会多一层桶名
S3_PUBLIC_INCLUDE_BUCKET=true

# ===== 导入队列 =====
IMPORT_CONCURRENCY=2

# ===== Figma Webhook（可选）=====
# 在 Figma 控制台创建 webhook：Endpoint 指向 https://<域名>/api/webhooks/figma，事件选 FILE_UPDATE
# 配置后此处填密钥，并要求请求头 X-Webhook-Secret 或 body.passcode 一致；留空则不校验
WEBHOOK_SECRET=

# ===== MCP：AI 编码工具接入 =====
# 管理员全开令牌（可选）。不设置也可以：用团队「导入令牌」作为 Bearer 访问 /mcp。
MCP_TOKEN=
# 线上默认拒绝匿名访问；仅本地开发或显式置 1 才放开，生产不建议开启
MCP_ALLOW_ANONYMOUS=

# ===== 邮件（注册验证 / 找回密码）=====
# outbox（默认，邮件写到本地 outbox/ 目录）| resend | smtp
EMAIL_PROVIDER=outbox
EMAIL_FROM=
EMAIL_OUTBOX_DIR=outbox
# 验证邮件链接指向的前端域名
WEB_BASE_URL=http://localhost:5173
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# 注：VERCEL / NODE_ENV 由运行平台注入，请勿手工设置（本地手设 NODE_ENV=production 会触发 AUTH_SECRET 强校验）。
