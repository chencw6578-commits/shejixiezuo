# ===== 服务 =====
PORT=4000

# ===== Figma =====
# 在 Figma → Settings → Security → Personal access tokens 生成
# 需要文件所在团队/项目授予该 token 访问权限
FIGMA_TOKEN=

# ===== 数据库 =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/designhub

# ===== 对象存储 =====
# local  = 本地磁盘（开发默认，落到 STORAGE_LOCAL_DIR，由服务端 /storage 静态托管）
# s3     = S3/MinIO（生产）
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# S3/MinIO 配置（STORAGE_DRIVER=s3 时生效）
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=designhub
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# 有公网/内网可直达 MinIO 的基址时填写，如 http://minio.internal:9000；留空用预签名 URL
S3_PUBLIC_BASE_URL=

# ===== 导入队列 =====
IMPORT_CONCURRENCY=2
