# ===== 服务 =====
PORT=4000

# ===== 认证（生产 / Vercel 必填）=====
# 会话 cookie 签名与公开分享链接 HMAC 共用同一个密钥。
# 生产环境缺失会在启动时直接报错，不会回退到默认密钥。
# 生成方式：openssl rand -hex 32
AUTH_SECRET=

# ===== Figma =====
# 在 Figma → Settings → Security → Personal access tokens 生成
# 需要文件所在团队/项目授予该 token 访问权限
FIGMA_TOKEN=

# ===== 数据库 =====
DATABASE_URL=postgres://postgres:postgres@localhost:5432/designhub

# ===== 对象存储 =====
# local = 本地磁盘（开发默认，落到 STORAGE_LOCAL_DIR，由服务端 /storage 静态托管）
# s3    = S3/MinIO（常驻生产）
# blob  = Vercel Blob（Serverless 默认，BLOB_READ_WRITE_TOKEN 由 Vercel 连接 Store 后自动注入）
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage

# S3/MinIO 配置（STORAGE_DRIVER=s3 时生效）
# 新团队实例用私有桶时设为 1，同时留空 S3_PUBLIC_BASE_URL。
S3_PRIVATE=0
# s3 = 默认 S3 兼容配置；cos = 腾讯云 COS，使用桶域名和 COS 兼容请求。
S3_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=designhub
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
# 有公网/内网可直达 MinIO 的基址时填写，如 http://minio.internal:9000；留空用预签名 URL
S3_PUBLIC_BASE_URL=
# R2 的 r2.dev / 自定义域已直接指向桶，需设为 false，否则 URL 会多一层桶名
S3_PUBLIC_INCLUDE_BUCKET=true

# ---------------------------------------------------------------------------
# Cloudflare R2 迁移示例（推荐，替代 Vercel Blob）
# ---------------------------------------------------------------------------
# 1) 在 Cloudflare 控制台 → R2 → 创建桶（如 designhub），并开启 r2.dev 公开访问
#    或绑定自定义域（如 cdn.example.com），确保图片 URL 可匿名访问。
# 2) R2 → Manage R2 API Tokens → Create API token，权限选 Object Read & Write，
#    拿到 Access Key ID / Secret Access Key（S3 兼容凭据）。
# 3) 把以下值填到 Vercel 环境变量（Production + Preview），STORAGE_DRIVER 改为 s3。
#    切换后新建/重新导入的设计稿图片会写入 R2；历史 Blob 图片 URL 仍可继续读取，
#    可分批重新导入或写脚本搬运后再删 Blob（见迁移文档）。
#
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_BUCKET=designhub
# S3_REGION=auto
# S3_ACCESS_KEY=<R2 Access Key ID>
# S3_SECRET_KEY=<R2 Secret Access Key>
# S3_PUBLIC_BASE_URL=https://<YOUR_R2_PUBLIC_DOMAIN>   # 如 https://pub-xxxx.r2.dev
# S3_PUBLIC_INCLUDE_BUCKET=false                        # R2 公开域已指向桶，必须 false

# ===== 缩略图编码 =====
# 无损 WebP：相比 PNG 省约 60% 体积，像素逐字节一致（像素吸管取色不受影响）。
# 默认开启；设为 0 回退 PNG（极旧客户端兼容）。sharp 转码失败时自动回退 PNG。
THUMB_WEBP=1

# ===== 导入队列 =====
IMPORT_CONCURRENCY=2
# 节点渲染图（nodes.render_url）仅在画布退到矢量模式才显示；缩略图存在时永远走主图模式。
# 默认跳过生成以节省存储与 Figma API 配额（前端有 CSS 近似兜底，功能不降级）。
# 需要恢复旧行为时设为 1。
GENERATE_NODE_RENDERS=0

# ===== Figma Webhook（可选）=====
# 在 Figma 控制台创建 webhook：Endpoint 指向 https://<域名>/api/webhooks/figma，事件选 FILE_UPDATE
# 配置后此处填密钥，并要求请求头 X-Webhook-Secret 或 body.passcode 一致；留空则不校验
WEBHOOK_SECRET=

# ===== MCP：AI 编码工具接入 =====
# 管理员全开令牌（可选）。不设置也可以：用团队「导入令牌」作为 Bearer 访问 /mcp。
MCP_TOKEN=
# 线上默认拒绝匿名访问；仅本地开发或显式置 1 才放开，生产不建议开启
MCP_ALLOW_ANONYMOUS=

# ===== 邮件（注册验证 / 找回密码）=====
# outbox（默认，邮件写到本地 outbox/ 目录）| resend | smtp
EMAIL_PROVIDER=outbox
EMAIL_FROM=
EMAIL_OUTBOX_DIR=outbox
# 验证邮件链接指向的前端域名
WEB_BASE_URL=http://localhost:5173
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# 注：VERCEL / NODE_ENV 由运行平台注入，请勿手工设置（本地手设 NODE_ENV=production 会触发 AUTH_SECRET 强校验）。
