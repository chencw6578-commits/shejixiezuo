# 服务端启动配置示例（复制为 .env 后填写；.env 已被 .gitignore 忽略，勿提交真实值）

# HTTP 端口
PORT=4000

# ===== 认证（生产 / Vercel 必填）=====
# 会话 cookie 签名与公开分享链接 HMAC 共用。生产缺失会在启动时直接报错。
# 生成方式：openssl rand -hex 32
AUTH_SECRET=

# PostgreSQL 连接串（本地开发默认 5433）
DATABASE_URL=postgres://postgres:postgres@localhost:5433/designhub

# Figma 服务端统一令牌（可选，缺失不阻止启动）
# 用途：让所有用户「零配置」导入公开可查看的 Figma 文件；令牌只在服务端使用，
#      不会下发到前端、不会写入响应或日志。
# 所需 scope：file_content:read（读取文件内容）；如需导出切图，另需 file_dev_resources:read
# 获取方式：Figma → Settings → Security → Personal access tokens
FIGMA_TOKEN=

# 存储（local | s3 | blob；blob 用于 Vercel Serverless，BLOB_READ_WRITE_TOKEN 由 Vercel 自动注入）
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage

# S3 / MinIO（STORAGE_DRIVER=s3 时生效）
# 新团队实例用私有桶时设为 1，同时留空 S3_PUBLIC_BASE_URL。
S3_PRIVATE=0
# 腾讯云 COS 设为 cos，Endpoint 填地域域名（如 https://cos.ap-nanjing.myqcloud.com）。
S3_PROVIDER=s3
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=designhub
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=
# R2 的公开域已直接指向桶时需设为 false
S3_PUBLIC_INCLUDE_BUCKET=true

# ===== MCP：AI 编码工具接入 =====
# 管理员全开令牌（可选）；不设置时用团队「导入令牌」作为 Bearer
MCP_TOKEN=
# 线上默认拒绝匿名访问，仅本地开发或显式置 1 才放开
MCP_ALLOW_ANONYMOUS=

# ===== 邮件（注册验证 / 找回密码）=====
# outbox（默认，写本地 outbox/）| resend | smtp
EMAIL_PROVIDER=outbox
EMAIL_FROM=
EMAIL_OUTBOX_DIR=outbox
# 验证邮件链接指向的前端域名
WEB_BASE_URL=http://localhost:5173
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=

# 注：VERCEL / NODE_ENV 由运行平台注入，请勿手工设置（本地手设 NODE_ENV=production 会触发 AUTH_SECRET 强校验）。
