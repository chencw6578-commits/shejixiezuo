# 服务端启动配置示例（复制为 .env 后填写；.env 已被 .gitignore 忽略，勿提交真实值）

# HTTP 端口
PORT=4000

# PostgreSQL 连接串（本地开发默认 5433）
DATABASE_URL=postgres://postgres:postgres@localhost:5433/designhub

# Figma 服务端统一令牌（可选，缺失不阻止启动）
# 用途：让所有用户「零配置」导入公开可查看的 Figma 文件；令牌只在服务端使用，
#      不会下发到前端、不会写入响应或日志。
# 所需 scope：file_content:read（读取文件内容）；如需导出切图，另需 file_dev_resources:read
# 获取方式：Figma → Settings → Security → Personal access tokens
FIGMA_TOKEN=

# 存储（local 或 s3）
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=storage

# S3 / MinIO（STORAGE_DRIVER=s3 时生效）
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=designhub
S3_REGION=us-east-1
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_PUBLIC_BASE_URL=
